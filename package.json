{
  "name": "ignisrenderer",
  "version": "1.0.2",
  "description": "A high-performance 3D rendering engine built entirely from scratch in TypeScript, integrating a comprehensive CPU-based graphics pipeline as well as accelerated WebGL and WebGPU rendering pipelines for modern GPU rendering.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "dev": "bun x vite",
    "build": "bun run build:shaders && bun x vite build",
    "build:shaders": "bun scripts/generate_shader_manifest.mjs",
    "test": "bun run test:static",
    "test:static": "bun tests/run_all.mjs",
    "test:browser": "bun run test:browser:probe && bun run test:browser:webgl",
    "test:browser:probe": "bun tests/run_browser.mjs",
    "test:browser:webgl": "playwright test tests/browser/playwright",
    "test:lighting": "bun tests/static/lighting/test_lighting.mjs",
    "test:pointspot": "bun tests/static/lighting/test_point_spot_lighting.mjs",
    "test:sh": "bun tests/static/lighting/test_sh_lighting_regression.mjs",
    "test:winding": "bun tests/static/geometry/test_model_factory_winding.mjs",
    "test:sparse": "bun tests/static/loaders/test_sparse_accessor.mjs",
    "bench:physics-mesh-v2": "bun tests/benchmarks/bench_physics_mesh_collision_v2.mjs",
    "bench:webgpu-deferred": "bun tests/benchmarks/bench_webgpu_deferred.mjs",
    "bench:spatial-index": "bun tests/benchmarks/bench_spatial_index.mjs"
  },
  "keywords": [
    "renderer",
    "software-renderer",
    "3d",
    "typescript",
    "graphics",
    "pbr",
    "shading",
    "glTF",
    "rasterization",
    "cpu-rendering"
  ],
  "author": "Kunelinmc",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kunelinmc/IgnisRenderer.git"
  },
  "bugs": {
    "url": "https://github.com/Kunelinmc/IgnisRenderer/issues"
  },
  "homepage": "https://github.com/Kunelinmc/IgnisRenderer#readme",
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  },
  "dependencies": {
    "@webgpu/types": "^0.1.69"
  },
  "peerDependencies": {
    "@dimforge/rapier3d-compat": "*",
    "ammo.js": "*"
  },
  "peerDependenciesMeta": {
    "@dimforge/rapier3d-compat": {
      "optional": true
    },
    "ammo.js": {
      "optional": true
    }
  }
}
