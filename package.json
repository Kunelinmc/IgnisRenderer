{
	"name": "ignisrenderer",
	"version": "1.0.1",
	"description": "A high-performance 3D rendering engine built entirely from scratch in TypeScript, integrating a comprehensive CPU-based graphics pipeline as well as accelerated WebGL and WebGPU rendering pipelines for modern GPU rendering.",
	"main": "src/index.ts",
	"types": "src/index.ts",


	"directories": {
		"test": "tests"
	},
	"scripts": {
		"dev": "vite",
		"build": "tsc && vite build",
		"test": "npx tsx tests/run_all.mjs",
		"test:lighting": "npx tsx tests/test_lighting.mjs",
		"test:pointspot": "npx tsx tests/test_point_spot_lighting.mjs",
		"test:sh": "npx tsx tests/test_sh_lighting_regression.mjs",
		"test:winding": "npx tsx tests/test_model_factory_winding.mjs",
		"test:sparse": "npx tsx tests/test_sparse_accessor.mjs"
	},
	"keywords": [
		"renderer",
		"software-renderer",
		"3d",
		"typescript",
		"graphics",
		"pbr",
		"shading",
		"glTF",
		"rasterization",
		"cpu-rendering"
	],
	"author": "Kunelinmc",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Kunelinmc/IgnisRenderer.git"
	},
	"bugs": {
		"url": "https://github.com/Kunelinmc/IgnisRenderer/issues"
	},
	"homepage": "https://github.com/Kunelinmc/IgnisRenderer#readme",
	"license": "MIT",
	"type": "module",
	"devDependencies": {
		"typescript": "^5.9.3",
		"vite": "^7.3.1"
	},
	"dependencies": {
		"@webgpu/types": "^0.1.69"
	},
	"peerDependencies": {
		"@dimforge/rapier3d-compat": "*",
		"ammo.js": "*"
	},
	"peerDependenciesMeta": {
		"@dimforge/rapier3d-compat": {
			"optional": true
		},
		"ammo.js": {
			"optional": true
		}
	}
}
